# ============================================
# SmartOps Environment Configuration
# ============================================
# 复制此文件为 .env 并填入实际配置值
# cp .env.example .env

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=smartops

# ============================================
# LLM Configuration (大语言模型配置)
# ============================================
# 支持的模型提供商: qwen, deepseek, glm
LLM_PROVIDER=qwen

# API Key (从对应平台获取)
LLM_API_KEY=your_api_key_here

# 模型名称
# Qwen: qwen-turbo, qwen-plus, qwen-max
# DeepSeek: deepseek-chat, deepseek-coder
# GLM: glm-4, glm-4-air
LLM_MODEL=qwen-plus

# API Base URL (可选，如果使用自定义端点)
LLM_BASE_URL=

# ============================================
# Vector Database Configuration (向量数据库)
# ============================================
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_COLLECTION=smartops_knowledge

# ============================================
# Application Configuration
# ============================================
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ============================================
# Monitoring Configuration
# ============================================
# 指标采集频率（秒）
METRICS_INTERVAL=5

# 告警阈值
ALERT_CPU_THRESHOLD=85
ALERT_MEMORY_THRESHOLD=90
ALERT_LATENCY_THRESHOLD=2000
ALERT_ERROR_RATE_THRESHOLD=10
ALERT_DB_QUERY_THRESHOLD=2000

# ============================================
# Mock System Configuration (模拟故障系统)
# ============================================
MOCK_SYSTEM_ENABLED=true
MOCK_FAULT_MODE=false

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ============================================
# Frontend Configuration
# ============================================
VITE_API_BASE_URL=http://localhost:8000
